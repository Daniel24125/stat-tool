generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  EDITOR
  VIEWER
}

enum DatasetStatus {
  PROFILING
  READY
  FAILED
}

model User {
  id            String          @id @default(cuid())
  auth0Sub      String          @unique
  email         String?         @unique
  name          String?
  picture       String?
  createdAt     DateTime        @default(now())
  lastLoginAt   DateTime        @default(now())
  memberships   ProjectMember[]
  notifications Notification[]
  datasets      Dataset[]
  runs          AnalysisRun[]
  pipelines     Pipeline[]
  pipelineRuns  PipelineRun[]
}

model Project {
  id          String          @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  members     ProjectMember[]
  datasets    Dataset[]
  runs        AnalysisRun[]
  pipelines   Pipeline[]
}

model ProjectMember {
  projectId String
  userId    String
  role      Role
  addedAt   DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model Dataset {
  id          String        @id @default(cuid())
  projectId   String
  name        String
  fileName    String
  storageKey  String
  sizeBytes   Int
  sha256      String
  status      DatasetStatus @default(PROFILING)
  error       String?
  nRows       Int?
  nCols       Int?
  profile     Json?
  createdById String
  createdAt   DateTime      @default(now())
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User          @relation(fields: [createdById], references: [id])
  runs        AnalysisRun[]
  pipelineRuns PipelineRun[]

  @@index([projectId])
}

enum AnalysisType {
  OUTLIERS
  COMPARE
  REGRESSION
  CORRELATION
  PCA
  PLS
  CLUSTER
}

enum RunStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

model AnalysisRun {
  id           String       @id @default(cuid())
  projectId    String
  datasetId    String
  type         AnalysisType
  name         String
  params       Json
  excludeRows  Int[]
  // For OUTLIERS runs: the rows the user confirmed for exclusion.
  exclusions   Int[]
  exclusionsConfirmed Boolean @default(false)
  sourceRunId  String?
  pipelineRunId String?
  stepIndex    Int?
  status       RunStatus    @default(QUEUED)
  results      Json?
  error        String?
  durationMs   Int?
  createdById  String
  createdAt    DateTime     @default(now())
  finishedAt   DateTime?
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dataset      Dataset      @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id])
  pipelineRun  PipelineRun? @relation(fields: [pipelineRunId], references: [id], onDelete: Cascade)

  @@index([datasetId, createdAt])
  @@index([pipelineRunId])
  @@index([projectId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  projectId String?
  kind      String
  message   String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

// A reusable, ordered list of analysis steps. Steps refer to columns by name,
// so a pipeline can run on any dataset that has those columns.
model Pipeline {
  id          String        @id @default(cuid())
  projectId   String
  name        String
  description String?
  steps       Json
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User          @relation(fields: [createdById], references: [id])
  runs        PipelineRun[]

  @@index([projectId])
}

model PipelineRun {
  id          String        @id @default(cuid())
  pipelineId  String
  projectId   String
  datasetId   String
  // Snapshot of the steps at run time, so later edits don't change history.
  steps       Json
  status      RunStatus     @default(QUEUED)
  currentStep Int           @default(0)
  excludedRows Int[]
  error       String?
  createdById String
  createdAt   DateTime      @default(now())
  finishedAt  DateTime?
  pipeline    Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  dataset     Dataset       @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  createdBy   User          @relation(fields: [createdById], references: [id])
  analyses    AnalysisRun[]

  @@index([pipelineId, createdAt])
  @@index([datasetId])
}
