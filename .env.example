# Copy to .env (used by docker compose) and to apps/web/.env (for `npm run dev`).

# --- Auth0 (Regular Web Application) ---
# Allowed Callback URLs: http://localhost:3000/auth/callback
# Allowed Logout URLs:   http://localhost:3000
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# openssl rand -hex 32
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000

# --- Database ---
# Compose overrides this with its local Postgres. For prod use the Neon pooled URL.
DATABASE_URL=postgresql://stattool:stattool@localhost:5432/stattool

# --- Stats service (shared secret between Next.js and FastAPI) ---
# openssl rand -hex 32
INTERNAL_API_KEY=
STATS_API_URL=http://localhost:8000

# --- File storage (RustFS locally, Cloudflare R2 in prod) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_BUCKET=stattool
S3_ACCESS_KEY_ID=stattool
S3_SECRET_ACCESS_KEY=stattool-secret
